{
  "name": "worldbuilder",
  "version": "0.0.0",
  "private": true,
  "description": "The Worldbuilder monorepo root (see LICENSING.md for per-directory licences)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r --if-present build",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:no-real-data": "node scripts/check-no-real-data.mjs",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "vitepress>vite": "^7.3.2"
    }
  }
}
