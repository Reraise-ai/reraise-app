{
  "name": "@worldbuilder/level1-engines",
  "version": "0.0.0",
  "private": true,
  "description": "Level-1 engines (ADR-0035): the deterministic local rules engine, the what-if re-run and escalation helpers, the cloud System One HTTP adapter template (Jev preset) and the board display formatter",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@worldbuilder/core": "workspace:*"
  },
  "devDependencies": {
    "@worldbuilder/conformance": "workspace:*",
    "@worldbuilder/storage-markdown-files": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
