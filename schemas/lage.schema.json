{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldbuilder.invalid/schemas/v0/lage.schema.json",
  "title": "Lage",
  "description": "Board state of a Lage (a card of type `lage`). Stored as a JSON block in the card body; a rewrite archives the previous version (ADR-0006, ADR-0023). Only the Lage format is persisted, never canvas-library state (ADR-0019).",
  "type": "object",
  "properties": {
    "question": {
      "description": "The guiding question of the Lage (required). On a theme Lage this is the theme line; the playable questions live in `questions`.",
      "$ref": "common.schema.json#/$defs/text"
    },
    "questions": {
      "description": "Playable questions of a theme field (e-58, ADR-0051). 2 to 4 items. Each lists the cards arguing for and against. A single-question Lage omits this.",
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/themeQuestion" }
    },
    "collectorCardId": {
      "description": "The one collector card of this theme (e-52, ADR-0051). Required when `questions` is present.",
      "$ref": "common.schema.json#/$defs/cardId"
    },
    "options": {
      "description": "The options under consideration.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/text" },
      "uniqueItems": true
    },
    "cards": {
      "description": "Cards placed on the board with their positions.",
      "type": "array",
      "items": { "$ref": "#/$defs/placement" }
    },
    "seats": {
      "description": "Players at the table: humans and agents.",
      "type": "array",
      "items": { "$ref": "#/$defs/seat" }
    },
    "edges": {
      "description": "Edges drawn on this board.",
      "type": "array",
      "items": { "$ref": "#/$defs/lageEdge" }
    },
    "version": {
      "description": "Version number of this state; increases on every rewrite. Used for optimistic concurrency.",
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "description": "Time (or date, as some stores record it) of the last change.",
      "type": "string",
      "anyOf": [{ "format": "date-time" }, { "format": "date" }]
    }
  },
  "required": ["question", "options", "cards", "seats", "edges", "version", "updatedAt"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "questions": true },
        "required": ["questions"]
      },
      "then": {
        "properties": { "collectorCardId": true },
        "required": ["collectorCardId"]
      }
    },
    {
      "if": {
        "properties": { "collectorCardId": true },
        "required": ["collectorCardId"]
      },
      "then": {
        "properties": { "questions": true },
        "required": ["questions"]
      }
    }
  ],
  "$defs": {
    "themeQuestion": {
      "title": "ThemeQuestion",
      "description": "One playable question of a theme, with the cards arguing for and against (e-58).",
      "type": "object",
      "properties": {
        "text": { "$ref": "common.schema.json#/$defs/text" },
        "for": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/cardId" },
          "uniqueItems": true
        },
        "against": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/cardId" },
          "uniqueItems": true
        }
      },
      "required": ["text", "for", "against"],
      "additionalProperties": false
    },
    "placement": {
      "title": "LagePlacement",
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/cardId" },
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["id", "x", "y"],
      "additionalProperties": false
    },
    "seat": {
      "title": "LageSeat",
      "type": "object",
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/text" },
        "kind": { "type": "string", "enum": ["human", "agent"] }
      },
      "required": ["name", "kind"],
      "additionalProperties": false
    },
    "lageEdge": {
      "title": "LageEdge",
      "type": "object",
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/cardId" },
        "to": { "$ref": "common.schema.json#/$defs/cardId" },
        "kind": { "$ref": "common.schema.json#/$defs/edgeKind" },
        "by": { "$ref": "common.schema.json#/$defs/knownAuthor" }
      },
      "required": ["from", "to", "kind", "by"],
      "additionalProperties": false
    }
  }
}
