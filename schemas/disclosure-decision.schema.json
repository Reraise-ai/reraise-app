{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldbuilder.invalid/schemas/v0/disclosure-decision.schema.json",
  "title": "DisclosureDecision",
  "description": "Result of DisclosureGate.decide(card, target) (ADR-0012). Default deny: without a matching allow rule the decision is deny. An allow for cloud_model is only valid with the user's per-transfer confirmation. Stance data is allowed for target screen only. Decisions are logged without card content.",
  "type": "object",
  "properties": {
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/disclosureTarget"
    },
    "decision": {
      "type": "string",
      "enum": ["allow", "deny"]
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "ruleId": {
      "description": "The allow rule that matched, if any.",
      "type": "string",
      "minLength": 1
    },
    "confirmationRequired": {
      "description": "True when the decision is deny only because the per-transfer confirmation is missing.",
      "type": "boolean"
    },
    "confirmation": {
      "$ref": "#/$defs/confirmation"
    },
    "decidedAt": {
      "$ref": "common.schema.json#/$defs/dateTime"
    }
  },
  "required": ["subject", "target", "decision", "reason", "decidedAt"],
  "additionalProperties": false,
  "allOf": [
    {
      "description": "cloud_model requires a per-transfer confirmation for every allow.",
      "if": {
        "properties": {
          "target": {
            "const": "cloud_model"
          },
          "decision": {
            "const": "allow"
          }
        },
        "required": ["target", "decision"]
      },
      "then": {
        "properties": {
          "confirmation": true
        },
        "required": ["confirmation"]
      }
    },
    {
      "description": "Confirmations exist only for cloud_model transfers.",
      "if": {
        "properties": {
          "confirmation": true
        },
        "required": ["confirmation"]
      },
      "then": {
        "properties": {
          "target": {
            "const": "cloud_model"
          }
        }
      }
    },
    {
      "description": "Stance data never leaves the screen (ADR-0008).",
      "if": {
        "properties": {
          "subject": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "stance"
              }
            },
            "required": ["kind"]
          },
          "decision": {
            "const": "allow"
          }
        },
        "required": ["subject", "decision"]
      },
      "then": {
        "properties": {
          "target": {
            "const": "screen"
          }
        }
      }
    }
  ],
  "$defs": {
    "subject": {
      "title": "DisclosureSubject",
      "description": "What is being disclosed: a card, or the user's stance data on a card.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["card", "stance"]
        },
        "cardId": {
          "$ref": "common.schema.json#/$defs/cardId"
        }
      },
      "required": ["kind", "cardId"],
      "additionalProperties": false
    },
    "transfer": {
      "title": "DisclosureTransfer",
      "description": "A previewed cloud_model transfer awaiting the user's confirmation (ADR-0012, ADR-0031). `cardIds` lists the ids of the objects in the envelope; `payloadHash` must be echoed by the confirmation; the transfer expires at `expiresAt` and can be confirmed once.",
      "type": "object",
      "properties": {
        "transferId": {
          "$ref": "common.schema.json#/$defs/ulid"
        },
        "purpose": {
          "type": "string",
          "enum": ["context_package", "level1", "export"]
        },
        "cardIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/cardId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "payloadHash": {
          "$ref": "#/$defs/payloadHash"
        },
        "preview": {
          "$ref": "#/$defs/previewEnvelope"
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/dateTime"
        }
      },
      "required": [
        "transferId",
        "purpose",
        "cardIds",
        "payloadHash",
        "preview",
        "createdAt",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "confirmRequest": {
      "title": "DisclosureConfirmRequest",
      "description": "Body of the human-only confirm operation. The server rejects a payloadHash that differs from the transfer's (409), an expired transfer (410) and a second confirmation of the same transfer (409).",
      "type": "object",
      "properties": {
        "payloadHash": {
          "$ref": "#/$defs/payloadHash"
        }
      },
      "required": ["payloadHash"],
      "additionalProperties": false
    },
    "confirmation": {
      "title": "DisclosureConfirmation",
      "description": "The user's confirmation of one transfer. No standing consent: it covers this payload only.",
      "type": "object",
      "properties": {
        "transferId": {
          "$ref": "common.schema.json#/$defs/ulid"
        },
        "payloadHash": {
          "$ref": "#/$defs/payloadHash"
        },
        "cardIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/cardId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "confirmedBy": {
          "$ref": "common.schema.json#/$defs/humanAuthor"
        },
        "confirmedAt": {
          "$ref": "common.schema.json#/$defs/dateTime"
        }
      },
      "required": ["transferId", "payloadHash", "cardIds", "confirmedBy", "confirmedAt"],
      "additionalProperties": false
    },
    "payloadHash": {
      "title": "PayloadHash",
      "description": "sha256:<lower-case hex> over the RFC 8785 (JCS) serialisation of the preview envelope (ADR-0031, ADR-0034).",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "modelRequest": {
      "title": "DisclosureModelRequest",
      "description": "The request parameters that go to the model with the objects.",
      "type": "object",
      "properties": {
        "question": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "uniqueItems": true
        },
        "outputSchema": {
          "description": "JSON Schema the answer must follow (level 1).",
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "previewEnvelope": {
      "title": "DisclosurePreviewEnvelope",
      "description": "Exactly what would leave the device: the target, the connector, the request parameters and the canonical objects after the gate decision. The payload hash covers this envelope.",
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "const": "cloud_model"
        },
        "connectorId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "request": {
          "$ref": "#/$defs/modelRequest"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "card.schema.json"
          },
          "minItems": 1
        }
      },
      "required": ["target", "connectorId", "request", "objects"],
      "additionalProperties": false
    },
    "previewRequest": {
      "title": "DisclosurePreviewRequest",
      "description": "Body of the human-only preview operation: what the user wants to send. The server builds the envelope from gate-cleared canonical objects only.",
      "type": "object",
      "properties": {
        "connectorId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "purpose": {
          "type": "string",
          "enum": ["context_package", "level1", "export"]
        },
        "request": {
          "$ref": "#/$defs/modelRequest"
        },
        "cardIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/cardId"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["connectorId", "purpose", "request", "cardIds"],
      "additionalProperties": false
    }
  }
}
