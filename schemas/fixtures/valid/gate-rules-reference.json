{
  "synthetic": true,
  "schema": "https://worldbuilder.invalid/schemas/v0/gate-rules.schema.json",
  "description": "Allow and deny rules for the Hormuz example: deny wins for class A.",
  "data": {
    "rules": [
      {
        "id": "screen-all-private",
        "effect": "allow",
        "targets": ["screen"],
        "match": {
          "visibility": ["private", "public"]
        },
        "description": "The local user sees their own cards."
      },
      {
        "id": "screen-all",
        "effect": "allow",
        "targets": ["screen"],
        "match": {}
      },
      {
        "id": "hormuz-class-c-models",
        "effect": "allow",
        "targets": ["local_model", "cloud_model"],
        "match": {
          "worlds": ["Hormuz"],
          "class": ["C"]
        }
      },
      {
        "id": "demo-synthetic",
        "effect": "allow",
        "targets": ["demo"],
        "match": {
          "syntheticStore": true
        }
      },
      {
        "id": "never-class-a",
        "effect": "deny",
        "targets": ["local_model", "cloud_model", "demo"],
        "match": {
          "class": ["A"]
        }
      },
      {
        "id": "never-tagged-private",
        "effect": "deny",
        "targets": ["cloud_model"],
        "match": {
          "tags": ["private"]
        }
      }
    ]
  }
}
