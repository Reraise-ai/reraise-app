{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    "noImplicitAny": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "@worldbuilder/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["scripts/**/*.mjs", "*.js", "*.ts"]
}
