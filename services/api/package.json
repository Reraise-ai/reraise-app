{
  "name": "@worldbuilder/api",
  "version": "0.0.0",
  "private": true,
  "description": "Board HTTP API service and the worldbuilder command line",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "worldbuilder": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@worldbuilder/core": "workspace:*",
    "@worldbuilder/disclosure-gate": "workspace:*",
    "@worldbuilder/knowledge-loop": "workspace:*",
    "@worldbuilder/level1-engines": "workspace:*",
    "@worldbuilder/local-state": "workspace:*",
    "@worldbuilder/mcp-server": "workspace:*",
    "@worldbuilder/storage-markdown-files": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@worldbuilder/conformance": "workspace:*"
  }
}
